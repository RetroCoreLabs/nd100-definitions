{
  "device_types": {
    "rtc": {
      "description": "Real-Time Clock",
      "register_count": 4,
      "registers": [
        {
          "offset": 0,
          "label_suffix": "READ_DATA",
          "name": "Read Data Register",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0-15", "name": "Returns 0" }
          ]
        },
        {
          "offset": 1,
          "label_suffix": "CLEAR_COUNTER",
          "name": "Clear Counter",
          "direction": "Write",
          "description": "Clear real-time clock counter.\nNext clock pulse occurs exactly 20 ms later.\nRepeated execution prevents counter increment."
        },
        {
          "offset": 2,
          "label_suffix": "READ_STATUS",
          "name": "Read Status Register",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0", "name": "Interrupt Enabled - clock will interrupt on next pulse" },
            { "bits": "1", "name": "(unused)" },
            { "bits": "2", "name": "External Hold Pulse received" },
            { "bits": "3", "name": "Ready for Transfer - clock pulse occurred" },
            { "bits": "4-15", "name": "(unused)" }
          ]
        },
        {
          "offset": 3,
          "label_suffix": "WRITE_CONTROL",
          "name": "Write Control Register",
          "direction": "Write",
          "bit_fields": [
            { "bits": "0", "name": "Enable interrupt on Ready for Transfer" },
            { "bits": "1", "name": "Return address on opcom segment (RETSG)" },
            { "bits": "2-9", "name": "(unused)" },
            { "bits": "10-11", "name": "Frequency select (0=Stop, 1=100us, 2=10us, 3=1us)" },
            { "bits": "12", "name": "External Hold Enable (1=enable, 0=disable)" },
            { "bits": "13", "name": "Clear Ready for Transfer flag" },
            { "bits": "14", "name": "Clear External Hold signal" },
            { "bits": "15", "name": "Restart clock (preset to N-1)" }
          ]
        }
      ]
    },
    "terminal": {
      "description": "Terminal",
      "register_count": 8,
      "registers": [
        {
          "offset": 0,
          "label_suffix": "READ_INPUT",
          "name": "Read Input Data",
          "direction": "Read",
          "description": "Read input data character from terminal"
        },
        {
          "offset": 1,
          "label_suffix": "WRITE_NOP",
          "name": "Write (No Operation)",
          "direction": "Write",
          "description": "No operation"
        },
        {
          "offset": 2,
          "label_suffix": "READ_INPUT_STATUS",
          "name": "Read Input Status",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0", "name": "Interrupt Enabled - data available gives interrupt" },
            { "bits": "1", "name": "(unused)" },
            { "bits": "2", "name": "Device Activated" },
            { "bits": "3", "name": "Ready for Transfer - data available" },
            { "bits": "4", "name": "Error OR - inclusive OR of bits 5-7" },
            { "bits": "5", "name": "Framing Error" },
            { "bits": "6", "name": "Parity Error" },
            { "bits": "7", "name": "Overrun" },
            { "bits": "8-10", "name": "(unused)" },
            { "bits": "11", "name": "Carrier Missing" },
            { "bits": "12-15", "name": "(unused)" }
          ]
        },
        {
          "offset": 3,
          "label_suffix": "WRITE_INPUT_CTRL",
          "name": "Write Input Control",
          "direction": "Write",
          "bit_fields": [
            { "bits": "0", "name": "Enable interrupt on data available" },
            { "bits": "1", "name": "(unused)" },
            { "bits": "2", "name": "Activate Device" },
            { "bits": "3", "name": "Test Mode" },
            { "bits": "4", "name": "Device Clear" },
            { "bits": "5-10", "name": "(unused)" },
            { "bits": "11-12", "name": "Character Length (0=8, 1=7, 2=6, 3=5)" },
            { "bits": "13", "name": "Stop Bits (0=2 bits, 1=1 bit)" },
            { "bits": "14", "name": "Parity (0=none, 1=even parity)" },
            { "bits": "15", "name": "(unused)" }
          ]
        },
        {
          "offset": 4,
          "label_suffix": "READ_ZERO",
          "name": "Read (Returns 0)",
          "direction": "Read",
          "description": "Returns 0 in A register, no other effect"
        },
        {
          "offset": 5,
          "label_suffix": "WRITE_DATA",
          "name": "Write Output Data",
          "direction": "Write",
          "description": "Write data character to terminal output"
        },
        {
          "offset": 6,
          "label_suffix": "READ_OUTPUT_STATUS",
          "name": "Read Output Status",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0", "name": "Interrupt Enabled - ready gives interrupt" },
            { "bits": "1-2", "name": "(unused)" },
            { "bits": "3", "name": "Ready for Transfer" },
            { "bits": "4-15", "name": "(unused)" }
          ]
        },
        {
          "offset": 7,
          "label_suffix": "WRITE_OUTPUT_CTRL",
          "name": "Write Output Control",
          "direction": "Write",
          "bit_fields": [
            { "bits": "0", "name": "Enable interrupt on ready for transfer" },
            { "bits": "1-15", "name": "(unused)" }
          ]
        }
      ]
    },
    "paper_tape": {
      "description": "Paper Tape Reader",
      "register_count": 4,
      "registers": [
        {
          "offset": 0,
          "label_suffix": "READ_DATA",
          "name": "Read Data",
          "direction": "Read",
          "description": "Read data byte from tape"
        },
        {
          "offset": 1,
          "label_suffix": "WRITE_DATA",
          "name": "Write Data Buffer",
          "direction": "Write"
        },
        {
          "offset": 2,
          "label_suffix": "READ_STATUS",
          "name": "Read Status",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0", "name": "Interrupt Enabled" },
            { "bits": "1", "name": "(unused)" },
            { "bits": "2", "name": "Read Active" },
            { "bits": "3", "name": "Ready for Transfer" },
            { "bits": "4-15", "name": "(unused)" }
          ]
        },
        {
          "offset": 3,
          "label_suffix": "WRITE_CONTROL",
          "name": "Write Control",
          "direction": "Write",
          "bit_fields": [
            { "bits": "0", "name": "Interrupt Enable" },
            { "bits": "1", "name": "(unused)" },
            { "bits": "2", "name": "Activate" },
            { "bits": "3", "name": "Ready for Transfer" },
            { "bits": "4", "name": "Device Clear" },
            { "bits": "5-15", "name": "(unused)" }
          ]
        }
      ]
    },
    "smd": {
      "description": "SMD Disk Controller",
      "register_count": 8,
      "registers": [
        {
          "offset": 0,
          "label_suffix": "READ_MEM_ADDR",
          "name": "Read Core Address",
          "direction": "Read",
          "description": "Read current memory (core) address register"
        },
        {
          "offset": 1,
          "label_suffix": "LOAD_MEM_ADDR",
          "name": "Load Core Address",
          "direction": "Write",
          "description": "Load memory (core) address for DMA transfer"
        },
        {
          "offset": 2,
          "label_suffix": "READ_SEEK_COND",
          "name": "Read Seek Condition (CWR=0) / Read ECC Count (CWR=1)",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0-7", "name": "Seek Complete status for units 0-7" },
            { "bits": "8-10", "name": "Unit number from last control word" },
            { "bits": "11", "name": "Seek Error for selected unit" },
            { "bits": "12", "name": "SMD 15MHz (always 1 for ND632)" },
            { "bits": "13", "name": "ECC error is correctable" },
            { "bits": "14", "name": "ECC parity error (HW fault)" },
            { "bits": "15", "name": "Last field read was address field" }
          ],
          "description": "--- CWR bit 15 = 0: Seek Condition ---\n--- CWR bit 15 = 1: ECC Count ---"
        },
        {
          "offset": 3,
          "label_suffix": "LOAD_BLOCK_ADDR",
          "name": "Load Block Address I (CWR=0) / Load Block Address II (CWR=1)",
          "direction": "Write",
          "description": "CWR=0: Load sector/track address\nCWR=1: Load cylinder number (triggers seek when Active bit set)"
        },
        {
          "offset": 4,
          "label_suffix": "READ_STATUS",
          "name": "Read Status (CWR=0) / Read ECC Pattern (CWR=1)",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0", "name": "Interrupt Enabled" },
            { "bits": "1", "name": "Error Interrupt Enabled" },
            { "bits": "2", "name": "Active (controller busy)" },
            { "bits": "3", "name": "Ready for Transfer" },
            { "bits": "4", "name": "Hardware Error (inclusive OR)" },
            { "bits": "5", "name": "Illegal Load" },
            { "bits": "6", "name": "Timeout" },
            { "bits": "7", "name": "Hardware Error 2 (disk fault)" },
            { "bits": "8", "name": "Address Mismatch" },
            { "bits": "9", "name": "(reserved)" },
            { "bits": "10", "name": "Comparer Error" },
            { "bits": "11-12", "name": "(reserved)" },
            { "bits": "13", "name": "Disk Unit Not Ready" },
            { "bits": "14", "name": "On Cylinder" },
            { "bits": "15", "name": "CWR bit (register multiplex)" }
          ],
          "description": "--- CWR bit 15 = 0: Status Register ---"
        },
        {
          "offset": 5,
          "label_suffix": "LOAD_CONTROL",
          "name": "Load Control Word",
          "direction": "Write",
          "bit_fields": [
            { "bits": "0", "name": "Enable interrupt on Not Active" },
            { "bits": "1", "name": "Enable interrupt on Errors" },
            { "bits": "2", "name": "Active (start operation, triggers seek)" },
            { "bits": "3", "name": "Test Mode" },
            { "bits": "4", "name": "Device Clear" },
            { "bits": "5-6", "name": "Core address bits 16-17" },
            { "bits": "7-9", "name": "Unit Select (max 4 units)" },
            { "bits": "10", "name": "Marginal Recovery Cycle" },
            { "bits": "11-14", "name": "Operation Code: 0=Read 1=Write 2=ReadParity 3=Compare 4=Seek 5=Format 6=SeekComplete 7=ReturnToZero 8=RunECC 9=SelectRelease" },
            { "bits": "15", "name": "CWR bit (register multiplex)" }
          ]
        },
        {
          "offset": 6,
          "label_suffix": "READ_BLOCK_ADDR",
          "name": "Read Block Address I (CWR=0) / Read Block Address II (CWR=1)",
          "direction": "Read",
          "description": "CWR=0: Read sector/track address\nCWR=1: Read cylinder number"
        },
        {
          "offset": 7,
          "label_suffix": "LOAD_WORD_COUNT",
          "name": "Load Word Count (CWR=0) / Load ECC Control (CWR=1)",
          "direction": "Write",
          "description": "CWR=0: Set number of words for DMA transfer\nCWR=1: Load ECC control register"
        }
      ]
    },
    "floppy_dma": {
      "description": "Floppy DMA Controller",
      "register_count": 8,
      "registers": [
        {
          "offset": 0,
          "label_suffix": "READ_DATA",
