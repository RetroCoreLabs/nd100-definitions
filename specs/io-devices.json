          "description": "This register is not used"
        },
        {
          "offset": 2,
          "label_suffix": "READ_STATUS1",
          "name": "Read Status Register 1",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0", "name": "(unused)" },
            { "bits": "1", "name": "Interrupt Enabled" },
            { "bits": "2", "name": "Device Active (controller busy)" },
            { "bits": "3", "name": "Ready for Transfer" },
            { "bits": "4", "name": "Error OR (inclusive OR of errors)" },
            { "bits": "5", "name": "Deleted Record / EOF marker" },
            { "bits": "6", "name": "Internal retry (no error)" },
            { "bits": "7", "name": "Hard Error (no memory contact)" },
            { "bits": "8-14", "name": "Error code from controller" },
            { "bits": "15", "name": "Dual Density controller" }
          ]
        },
        {
          "offset": 3,
          "label_suffix": "LOAD_CONTROL",
          "name": "Load Control Word",
          "direction": "Write",
          "bit_fields": [
            { "bits": "0", "name": "(unused)" },
            { "bits": "1", "name": "Enable Interrupt" },
            { "bits": "2", "name": "Activate Autoload" },
            { "bits": "3", "name": "Test Mode" },
            { "bits": "4", "name": "Device Clear" },
            { "bits": "5", "name": "Enable Streamer" },
            { "bits": "6-7", "name": "(unused)" },
            { "bits": "8", "name": "Execute Command (from command block in memory)" },
            { "bits": "9-13", "name": "Test Data (when test mode active)" },
            { "bits": "14-15", "name": "(unused)" }
          ]
        },
        {
          "offset": 4,
          "label_suffix": "READ_STATUS2",
          "name": "Read Status Register 2",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0-1", "name": "Bytes per Sector encoding" },
            { "bits": "2", "name": "Double Sided diskette" },
            { "bits": "3", "name": "Double Density format" },
            { "bits": "4-15", "name": "(unused)" }
          ]
        },
        {
          "offset": 5,
          "label_suffix": "LOAD_PTR_HI",
          "name": "Load Pointer High",
          "direction": "Write",
          "description": "Load command block pointer high bits (23-16)"
        },
        {
          "offset": 6,
          "label_suffix": "UNUSED6",
          "name": "(Not Used)",
          "direction": "None",
          "description": "This register is not used"
        },
        {
          "offset": 7,
          "label_suffix": "LOAD_PTR_LO",
          "name": "Load Pointer Low / Load Data",
          "direction": "Write",
          "description": "Load command block pointer low bits (15-0)"
        }
      ]
    },
    "line_printer": {
      "description": "Line Printer",
      "register_count": 4,
      "registers": [
        {
          "offset": 0,
          "label_suffix": "READ_DATA",
          "name": "Read Data",
          "direction": "Read",
