    "hdlc": {
      "description": "HDLC/Megalink",
      "register_count": 16,
      "registers": [
        { "offset": 0, "label_suffix": "RX_DATA", "name": "Receiver Data Register (RxDR)", "direction": "Read", "description": "Assembled byte from COM5025 receiver buffer" },
        { "offset": 1, "label_suffix": "PCR", "name": "Parameter Control Register (PCR)", "direction": "Write", "description": "HDLC protocol definition (8 bits). Written to COM5025 Mode register during INITIALIZE." },
        { "offset": 2, "label_suffix": "RX_STATUS", "name": "Receiver Status Register (RxSR)", "direction": "Read", "description": "COM5025 receiver status (8 bits)" },
        { "offset": 3, "label_suffix": "SAR", "name": "Sync/Address Register (SAR)", "direction": "Write", "description": "Station address (bit-oriented) or SYNC char (byte-oriented)" },
        { "offset": 4, "label_suffix": "CHL", "name": "Character Length Register (CHL)", "direction": "Write",
          "bit_fields": [
            { "bits": "0-2", "name": "Receiver character length" },
            { "bits": "3-4", "name": "(unused)" },
            { "bits": "5-7", "name": "Transmitter character length" }
          ],
          "description": "Usually 8 bits each (value 0x88)"
        },
        { "offset": 5, "label_suffix": "TX_DATA", "name": "Transmitter Data Register (TxDR)", "direction": "Write", "description": "Byte to transmit via COM5025" },
        { "offset": 6, "label_suffix": "TX_STATUS", "name": "Transmitter Status Register (TxSR)", "direction": "Read", "description": "COM5025 transmitter status (8 bits)" },
        { "offset": 7, "label_suffix": "TX_CTRL", "name": "Transmitter Control Word (TxCW)", "direction": "Write", "description": "COM5025 transmitter control (same bits as TxSR)" },
        { "offset": 8, "label_suffix": "RRTS", "name": "Receiver Transfer Status (RRTS)", "direction": "Read",
          "description": "High byte auto-cleared on read",
          "bit_fields": [
            { "bits": "0", "name": "DataAvailable — byte assembled in RX buffer" },
            { "bits": "1", "name": "StatusAvailable — status ready in RxSR" },
            { "bits": "2", "name": "ReceiverActive — frame in progress" },
            { "bits": "3", "name": "SyncFlagReceived — FLAG detected" },
            { "bits": "4", "name": "DMAModuleRequest — DMA needs attention (auto-clear)" },
            { "bits": "5", "name": "SD — Signal Detector (modem)" },
            { "bits": "6", "name": "DSR — Data Set Ready (modem)" },
            { "bits": "7", "name": "RI — Ring Indicator (modem)" },
            { "bits": "8", "name": "BlockEnd — DMA block complete (auto-clear)" },
            { "bits": "9", "name": "FrameEnd — HDLC frame received (auto-clear)" },
            { "bits": "10", "name": "ListEnd — descriptor list exhausted (auto-clear)" },
            { "bits": "11", "name": "ListEmpty — NO RX BUFFERS! Disables receiver (auto-clear)" },
            { "bits": "13", "name": "X21D — X.21 Data Indication Error" },
            { "bits": "14", "name": "X21S — X.21 Call Setup/Clear Error" },
            { "bits": "15", "name": "ReceiverOverrun — buffer overrun" }
          ]
        },
        { "offset": 9, "label_suffix": "WRTC", "name": "Receiver Transfer Control (WRTC)", "direction": "Write",
          "bit_fields": [
            { "bits": "0", "name": "DataAvailableIE — enable IRQ 13 on DataAvailable" },
            { "bits": "1", "name": "StatusAvailableIE — enable IRQ 13 on StatusAvailable" },
            { "bits": "2", "name": "EnableReceiver — turn on receiver" },
            { "bits": "3", "name": "EnableReceiverDMA — route DataAvail to DMA" },
            { "bits": "4", "name": "DMAModuleIE — enable IRQ 13 on DMA request" },
            { "bits": "5", "name": "DeviceClear+Maintenance — clear + enter loopback" },
            { "bits": "6", "name": "DTR — Data Terminal Ready" },
            { "bits": "7", "name": "ModemStatusChangeIE — enable IRQ on modem change" },
            { "bits": "8", "name": "BlockEndIE — enable IRQ on Block End" },
            { "bits": "9", "name": "FrameEndIE — enable IRQ on Frame End" },
            { "bits": "10", "name": "ListEndIE — enable IRQ on List End" }
          ]
        },
        { "offset": 10, "label_suffix": "RTTS", "name": "Transmitter Transfer Status (RTTS)", "direction": "Read",
          "description": "High byte auto-cleared on read",
          "bit_fields": [
            { "bits": "0", "name": "TxBufferEmpty — ready for new byte" },
            { "bits": "1", "name": "TxUnderrun — buffer not loaded in time" },
            { "bits": "2", "name": "TxActive — transmitter active" },
            { "bits": "6", "name": "RFS — Ready For Sending / CTS (modem)" },
            { "bits": "8", "name": "BlockEnd — DMA buffer sent (auto-clear)" },
            { "bits": "9", "name": "FrameEnd — HDLC frame sent TEOM (auto-clear)" },
            { "bits": "10", "name": "ListEnd — all descriptors done (auto-clear)" },
            { "bits": "11", "name": "TxFinished — DMA done, auto-sets DMAReq (auto-clear)" },
            { "bits": "15", "name": "Illegal — bad key/format in descriptor" }
          ]
        },
        { "offset": 11, "label_suffix": "WTTC", "name": "Transmitter Transfer Control (WTTC)", "direction": "Write",
          "bit_fields": [
            { "bits": "0", "name": "TxBufferEmptyIE — enable IRQ 12 on buffer empty" },
            { "bits": "1", "name": "TxUnderrunIE — enable IRQ 12 on underrun" },
            { "bits": "2", "name": "TxEnabled — enable transmitter output" },
            { "bits": "3", "name": "EnableTxDMA — route buffer-empty to DMA" },
            { "bits": "4", "name": "DMAModuleIE — enable IRQ 12 on DMA request" },
            { "bits": "5", "name": "HalfDuplex — half-duplex mode" },
            { "bits": "6", "name": "RTS — Request To Send" },
            { "bits": "7", "name": "ModemStatusChangeIE — enable IRQ on RFS change" },
            { "bits": "8", "name": "BlockEndIE — enable IRQ on Block End" },
            { "bits": "9", "name": "FrameEndIE — enable IRQ on Frame End" },
            { "bits": "10", "name": "ListEndIE — enable IRQ on List End" }
          ]
        },
        { "offset": 12, "label_suffix": "DMA_ADDR_R", "name": "DMA Address Read", "direction": "Read", "description": "Reads back last value written to DMA Address Write" },
        { "offset": 13, "label_suffix": "DMA_ADDR_W", "name": "DMA Address Write", "direction": "Write", "description": "16 LSBs of buffer/descriptor list address" },
        { "offset": 14, "label_suffix": "DMA_CMD_R", "name": "DMA Command Read", "direction": "Read", "description": "Read DMA command status (shifted left 8 bits)" },
        { "offset": 15, "label_suffix": "DMA_CMD_W", "name": "DMA Command Write", "direction": "Write",
          "bit_fields": [
            { "bits": "0-3", "name": "Bank bits for 18-bit DMA addressing" },
            { "bits": "8-10", "name": "Command: 0=CLEAR 1=INIT 2=RX_START 3=RX_CONT 4=TX_START 5=DUMP_DATA 6=DUMP_REGS 7=LOAD_REGS" }
          ]
        }
      ]
