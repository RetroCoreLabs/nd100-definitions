        },
        {
          "offset": 2,
          "label_suffix": "READ_STATUS",
          "name": "Read Status",
          "direction": "Read",
          "bit_fields": [
            { "bits": "0", "name": "Interrupt enabled on ready" },
            { "bits": "1", "name": "Interrupt enabled on error" },
            { "bits": "2", "name": "(unused)" },
            { "bits": "3", "name": "Ready for Transfer" },
            { "bits": "4", "name": "Error (bit 5 or 6 set)" },
            { "bits": "5", "name": "Line printer not ready" },
            { "bits": "6", "name": "Out of paper" },
            { "bits": "7", "name": "Compressed pitch" },
            { "bits": "8", "name": "LP9 (format/control code mode)" },
            { "bits": "9", "name": "Inhibit (illegal character in buffer)" },
            { "bits": "10", "name": "(unused)" },
            { "bits": "11-12", "name": "Band detect (00=128ch, 01=96ch, 10=64ch, 11=48ch)" },
            { "bits": "13-15", "name": "(unused)" }
          ]
        },
        {
          "offset": 3,
          "label_suffix": "WRITE_CONTROL",
          "name": "Write Control",
          "direction": "Write",
          "bit_fields": [
            { "bits": "0", "name": "Enable interrupt on ready for transfer" },
            { "bits": "1", "name": "Enable interrupt on error" },
            { "bits": "2", "name": "Activate (print character in buffer)" },
            { "bits": "3", "name": "Test mode" },
            { "bits": "4", "name": "Device and interface clear" },
            { "bits": "5-15", "name": "(unused)" }
          ]
        }
      ]
    },
    "nd500_interface": {
      "description": "ND-500 Interface",
