// EMIL code for TRR instruction
// Transfer A to internal register - Copy A register to internal register

// Field extract macros
#define REG ((instruction >> 0) & 0x0F)

// Trace helpers
void trace_pre(int level, const char* reg, uint16_t value) {
    printf("[%d] %s = 0x%04X\n", level, reg, value);
}

void trace_step(int level, const char* msg, uint16_t value) {
    printf("[%d] %s = 0x%04X\n", level, msg, value);
}

void trace_post(int level) {
    printf("[%d] Instruction complete\n", level);
}

// Function prototypes
void CheckPriv();
void ProcessTerminalPanc();

// Privilege check
if (!CheckPriv()) {
    return;
}

// Register access patterns
uint16_t A = gReg[CurrLEVEL, A];

// Trace pre-execution
trace_pre(1, "A", A);

// Main instruction logic
switch (REG) {
    case 0x00:  // Panel control
        gPANC = A;
        trace_step(1, "PANC<=A", A);
        if (PANEL_PROCESSOR)
            ProcessTerminalPanc();
        break;

    case 0x01:  // Status register (LSB only)
        uint16_t sts = gReg[CurrLEVEL, STS];
        sts = (sts & 0xFF00) | (A & 0x00FF);  // Only modify lower byte
        gReg[CurrLEVEL, STS] = sts;
        trace_step(1, "STS(LSB)<=A", sts);
        break;

    case 0x03:  // Program control register
        int temp = A;
        ushort level = (temp >> 3) & 0x0F;
        if (mmsType == MMS1)
            temp &= ~(1 << 2);  // Clear bit 2 for MMS1
        gReg_PCR[level] = temp;
        trace_step(1, "PCR(%d)<=A", level);
        break;

    case 0x06:  // Priority interrupt detect
        gReg[CurrLEVEL, PID] = A;
        trace_step(1, "PID<=A", A);
        break;

    // Add other internal register cases as needed

    default:
        // unknown register
        break;
}

// Trace post-execution
trace_post(1); 